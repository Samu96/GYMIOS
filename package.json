{
  "name": "mi-entreno-ios",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Mi entreno: app de gimnasio para iPhone (Capacitor 7)",
  "scripts": {
    "setup": "cap add ios && node scripts/patch-ios.mjs && cap sync ios",
    "patch": "node scripts/patch-ios.mjs",
    "sync": "cap sync ios",
    "open": "cap open ios"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^7.0.0",
    "@capacitor-community/speech-recognition": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/local-notifications": "^7.0.0",
    "@capacitor/share": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0"
  }
}
